# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
API_KEY_G="MY_GEMINI_API_KEY"

# WHATSAPP_ACCESS_TOKEN: Your Meta WhatsApp Business API access token.
WHATSAPP_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: Your Meta WhatsApp Business phone number ID.
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"

# WHATSAPP_VERIFY_TOKEN: A custom token you set in the Meta App dashboard to verify your webhook.
WHATSAPP_VERIFY_TOKEN="YOUR_VERIFY_TOKEN"

# GOOGLE_SHEET_ID: The ID of the Google Sheet to fetch leads from.
GOOGLE_SHEET_ID="YOUR_GOOGLE_SHEET_ID"

# FIREBASE CONFIGURATION (Optional: Can be used to override firebase-applet-config.json)
# Add these as secrets in the AI Studio Secrets panel with VITE_ prefix for frontend access.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="YOUR_FIREBASE_DATABASE_ID"

# GOOGLE_SERVICE_ACCOUNT_KEY: JSON key for Google Service Account.
# Add this as a secret in the AI Studio Secrets panel.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "...", ...}'
