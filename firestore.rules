rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "bmohit162001@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCompany(data) {
      return hasRequiredFields(['name', 'systemPrompt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.systemPrompt is string && data.systemPrompt.size() < 10000;
    }

    function isValidLead(data) {
      return hasRequiredFields(['companyId', 'name', 'phone', 'loanType', 'status']) &&
             data.companyId is string && data.companyId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() < 20 &&
             data.loanType is string &&
             data.status in ["new", "contacted", "converted", "lost"];
    }

    function isValidMessage(data) {
      return hasRequiredFields(['text', 'sender', 'timestamp']) &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.sender in ["agent", "user"] &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidCompany(request.resource.data);
      allow update: if isAuthenticated() && isValidCompany(request.resource.data);
      allow delete: if isAdmin();
    }

    // Leads collection
    match /leads/{leadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidLead(request.resource.data);
      allow update: if isAuthenticated() && isValidLead(request.resource.data);
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidMessage(request.resource.data);
        allow update: if isAuthenticated() && isValidMessage(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    // Users collection (for roles)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
